# ==============================================================================
# SovRoute-Box: Environment Configuration Template (.env.box)
# Copy this file to .env.box and populate credentials before launching.
# WARNING: NEVER commit .env.box to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Filesystem Storage Paths
# ------------------------------------------------------------------------------
# Root directory on host where durable blockchain & database state is stored.
# Ensure permissions: chown -R 2101:2101 ./bitcoin, 2102:2102 ./lightning, 2100:2100 ./router
SOVROUTE_DATA_DIR=/srv/sovereign-router
SOVROUTE_CONFIG_DIR=/srv/sovereign-router/config

# ------------------------------------------------------------------------------
# 2. Bitcoin Network Selection
# ------------------------------------------------------------------------------
# Options: mainnet, testnet, regtest, signet
BITCOIN_NETWORK=mainnet

# ------------------------------------------------------------------------------
# 3. Bitcoin Core RPC Credentials
# ------------------------------------------------------------------------------
# Dedicated credentials configured in bitcoin.conf via rpcauth=
BITCOIN_RPC_USER=sovereign_rpc_user
BITCOIN_RPC_PASSWORD=generate_a_strong_64_character_random_password_here

# ------------------------------------------------------------------------------
# 4. LND Lightning Node Configuration
# ------------------------------------------------------------------------------
# Port where LND exposes REST API inside sovereign_router_net (default: 8080)
LND_REST_PORT=8080

# Paths to the restricted macaroon and TLS cert mounted into the router container
LND_MACAROON_PATH=/srv/sovereign-router/secrets/router-restricted.macaroon
LND_TLS_CERT_PATH=/srv/sovereign-router/secrets/lnd-tls.cert

# ------------------------------------------------------------------------------
# 5. Base L2 Blockchain & Smart Contract Parameters
# ------------------------------------------------------------------------------
# Base Sepolia Testnet: 84532 | Base Mainnet: 8453
BASE_CHAIN_ID=84532

# Primary Base RPC Endpoint (HTTPS)
BASE_RPC_URL=https://sepolia.base.org

# Comma-separated Fallback Base RPC Endpoints (automatic failover if primary is rate-limited)
BASE_RPC_FALLBACK_URLS=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org

# Deployed Immutable HtlcErc20 Contract Address
# Verified Base Sepolia: 0x3e4b1374d2a42ed3aca3470978fc4ec52914ae6f
HTLC_CONTRACT_ADDRESS=0x3e4b1374d2a42ed3aca3470978fc4ec52914ae6f

# Canonical Circle USDC Token Contract Address
# Base Sepolia Testnet USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet Native USDC:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Operator Private Key (Holds Base USDC inventory for atomic escrows)
# NOTE: In production, store this in /srv/sovereign-router/secrets/operator.key
OPERATOR_PRIVATE_KEY=0x_your_hex_encoded_private_key_here

# ------------------------------------------------------------------------------
# 6. On-Chain Watcher & Reorg Safety Parameters
# ------------------------------------------------------------------------------
# Number of block confirmations required before triggering Lightning settlement (Base L2: 2-5)
WATCHER_REORG_CONFIRMATIONS=2

# Polling frequency in milliseconds for new blocks (default: 2000ms = 2s Base block time)
WATCHER_POLL_INTERVAL_MS=2000

# ------------------------------------------------------------------------------
# 7. Router Public Interface & Anti-Abuse Controls
# ------------------------------------------------------------------------------
# Host port mapping for public Swap API / Web DApp
ROUTER_HOST_PORT=3000

# Strict 60-second cooldown per client wallet
RATE_LIMIT_COOLDOWN_SEC=60

# Maximum single swap amount in USD (beta safeguard: 250 USD)
MAX_SINGLE_SWAP_USDC=250

# Maximum 24-hour rolling volume limit per destination wallet
ROLLING_24H_VOLUME_LIMIT=500
