# ===================================================================
# UNIVERSAL AGENT ASSET ROUTER — ENVIRONMENT CONFIGURATION
# ARCHITECTURE V4: SOVEREIGN ATOMIC CORE
# ===================================================================
#
# INVARIANT (SEC-16): The core engine, build, and test suite require
# ZERO hosted swap provider credentials to run.
#
# -------------------------------------------------------------------
# Core / Local Configuration (Optional)
# -------------------------------------------------------------------
NODE_ENV=development
DATABASE_PATH=./router.sqlite

# -------------------------------------------------------------------
# Sovereign Local Node Endpoints (Phase 2I — Production LND)
# -------------------------------------------------------------------
# LND REST endpoint (sovereign_router_net IP:port)
# LND_HOST=10.240.20.2
# LND_PORT=8080
# LND_NETWORK=mainnet
#
# Path to restricted macaroon (invoices:read, invoices:write, info:read only)
# LND_MACAROON_PATH=/srv/sovereign-router/secrets/router-restricted.macaroon
#
# Path to LND TLS certificate
# LND_TLS_CERT_PATH=/srv/sovereign-router/secrets/lnd-tls.cert
#
# Alternative: inline hex (if file paths unavailable in the environment)
# LND_MACAROON_HEX=
# LND_TLS_CERT_HEX=
#
# Base chain RPC
# BASE_RPC_URL=http://localhost:8546

# -------------------------------------------------------------------
# OPTIONAL EXTERNAL ADAPTERS (Disabled by default; not required for core)
# -------------------------------------------------------------------
# FIXEDFLOAT_API_KEY=
# FIXEDFLOAT_API_SECRET=
# SIDESHIFT_SECRET=
